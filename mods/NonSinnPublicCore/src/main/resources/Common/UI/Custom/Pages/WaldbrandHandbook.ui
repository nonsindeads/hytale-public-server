$C = "../Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Width: 1120, Height: 760);

  #Title {
    Label #HandbookTitle {
      Text: "DER WALDBRAND - HANDBUCH";
      Style: (...$C.@TitleStyle, HorizontalAlignment: Center);
      Padding: (Horizontal: 19);
    }
  }

  #Content {
    LayoutMode: Left;
    Padding: (Left: 18, Right: 18, Top: 18, Bottom: 18);

    Group #Navigation {
      Anchor: (Width: 220);
      LayoutMode: Top;
      Padding: (Right: 16);

      Label {
        Text: "KAPITEL";
        Anchor: (Height: 32);
        Style: (FontSize: 13, TextColor: #7CAACC, RenderBold: true, VerticalAlignment: Center);
      }

      $C.@SecondaryTextButton #NavStart {
        Text: "Start";
        Anchor: (Height: 48, Bottom: 8);
      }
      $C.@SecondaryTextButton #NavRules {
        Text: "Regeln";
        Anchor: (Height: 48, Bottom: 8);
      }
      $C.@SecondaryTextButton #NavWorlds {
        Text: "Welten";
        Anchor: (Height: 48, Bottom: 8);
      }
      $C.@SecondaryTextButton #NavClaims {
        Text: "Claims & Grundstuecke";
        Anchor: (Height: 48, Bottom: 8);
      }
      $C.@SecondaryTextButton #NavEconomy {
        Text: "Wirtschaft";
        Anchor: (Height: 48, Bottom: 8);
      }
      $C.@SecondaryTextButton #NavHelp {
        Text: "Hilfe & Kontakt";
        Anchor: (Height: 48);
      }

      Group { FlexWeight: 1; }

      Label {
        Text: "Tipp: /handbuch oeffnet dieses Fenster jederzeit erneut.";
        Anchor: (Height: 74);
        Style: (FontSize: 12, TextColor: #8FA5B7, Wrap: true, VerticalAlignment: End);
      }
    }

    Group {
      Anchor: (Width: 2);
      Background: #243746;
    }

    Group #Article {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
      Padding: (Left: 28, Right: 16, Bottom: 12);

      Label #ContentTitle {
        Text: "";
        Anchor: (Height: 48, Bottom: 6);
        Style: (FontSize: 28, TextColor: #F2C66D, RenderBold: true, VerticalAlignment: Center);
      }

      Label #ContentLead {
        Text: "";
        Anchor: (Height: 58, Bottom: 16);
        Style: (FontSize: 16, TextColor: #C7D7E5, Wrap: true);
      }

      Group { Anchor: (Height: 2, Bottom: 16); Background: #243746; }

      Label #SectionOneTitle {
        Text: "";
        Anchor: (Height: 30);
        Style: (FontSize: 18, TextColor: #E8A93B, RenderBold: true, VerticalAlignment: Center);
      }
      Label #SectionOneBody {
        Text: "";
        Anchor: (Height: 64, Bottom: 12);
        Style: (FontSize: 15, TextColor: #E6EDF3, Wrap: true);
      }

      Label #SectionTwoTitle {
        Text: "";
        Anchor: (Height: 30);
        Style: (FontSize: 18, TextColor: #E8A93B, RenderBold: true, VerticalAlignment: Center);
      }
      Label #SectionTwoBody {
        Text: "";
        Anchor: (Height: 64, Bottom: 12);
        Style: (FontSize: 15, TextColor: #E6EDF3, Wrap: true);
      }

      Label #SectionThreeTitle {
        Text: "";
        Anchor: (Height: 30);
        Style: (FontSize: 18, TextColor: #E8A93B, RenderBold: true, VerticalAlignment: Center);
      }
      Label #SectionThreeBody {
        Text: "";
        Anchor: (Height: 64, Bottom: 12);
        Style: (FontSize: 15, TextColor: #E6EDF3, Wrap: true);
      }

      Label #SectionFourTitle {
        Text: "";
        Anchor: (Height: 30);
        Style: (FontSize: 18, TextColor: #E8A93B, RenderBold: true, VerticalAlignment: Center);
      }
      Label #SectionFourBody {
        Text: "";
        Anchor: (Height: 82);
        Style: (FontSize: 15, TextColor: #E6EDF3, Wrap: true);
      }
    }
  }
}

$C.@BackButton {}
