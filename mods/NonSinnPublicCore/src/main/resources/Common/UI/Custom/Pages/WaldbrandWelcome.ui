$C = "../Common.ui";

$C.@PageOverlay {
  LayoutMode: Middle;

  $C.@DecoratedContainer {
    Anchor: (Width: 920, Height: 680);

    #Title {
      Label #WelcomeTitle {
        Text: "WILLKOMMEN BEI DER WALDBRAND";
        Style: (...$C.@TitleStyle, FontSize: 20, TextColor: #FFB347, HorizontalAlignment: Center);
        Padding: (Horizontal: 16);
      }
    }

    #Content {
      LayoutMode: Top;
      Padding: (Full: 20);

      #HeroHeader {
        LayoutMode: Top;
        Anchor: (Height: 80, Bottom: 14);

        Label #MainHero {
          Text: "WILLKOMMEN";
          Anchor: (Height: 34);
          Style: (FontSize: 28, TextColor: #FFFFFF, RenderBold: true, HorizontalAlignment: Center);
        }

        Label #SubHero {
          Text: "DER WALDBRAND";
          Anchor: (Height: 38);
          Style: (FontSize: 32, TextColor: #FFAA00, RenderBold: true, HorizontalAlignment: Center);
        }
      }

      Group { Anchor: (Height: 2, Bottom: 14); Background: #3E2F1E; }

      #InfoCards {
        LayoutMode: Left;
        Anchor: (Height: 230, Bottom: 14);

        #CardRules {
          FlexWeight: 1;
          LayoutMode: Top;
          Background: #141A24;
          Padding: (Full: 12);
          Anchor: (Right: 10);

          Label {
            Text: "1. FREISCHALTUNG";
            Anchor: (Height: 24);
            Style: (FontSize: 15, TextColor: #55FF88, RenderBold: true);
          }
          Label {
            Text: "Unser 1-Minuten-Quiz (/freischalten) schuetzt den Server vor Bots.\n\nBeantworte 6 kurze Fragen mit /antwort <Nummer> und werde sofort vollwertiger Spieler!";
            Anchor: (Height: 160);
            Style: (FontSize: 13, TextColor: #C7D7E5, Wrap: true);
          }
        }

        #CardGameplay {
          FlexWeight: 1;
          LayoutMode: Top;
          Background: #141A24;
          Padding: (Full: 12);
          Anchor: (Right: 10);

          Label {
            Text: "2. WELTEN & SCHUTZ";
            Anchor: (Height: 24);
            Style: (FontSize: 15, TextColor: #4DA6FF, RenderBold: true);
          }
          Label {
            Text: "Sichere dir persoenliches Land in der Survivalwelt mit /claim.\n\nErstelle dir ein dauerhaftes 64x64 Grundstueck in der Bauwelt mit /grundstueck kaufen!";
            Anchor: (Height: 160);
            Style: (FontSize: 13, TextColor: #C7D7E5, Wrap: true);
          }
        }

        #CardTeam {
          FlexWeight: 1;
          LayoutMode: Top;
          Background: #141A24;
          Padding: (Full: 12);

          Label {
            Text: "3. TEAM & COMMUNITY";
            Anchor: (Height: 24);
            Style: (FontSize: 15, TextColor: #FFD700, RenderBold: true);
          }
          Label {
            Text: "Server-Neustarts taeglich um 00:00, 08:00 und 16:00 Uhr.\n\nWir suchen Verstaerkung: Moechtest du als Builder, Modder oder Guide mitgestalten?";
            Anchor: (Height: 160);
            Style: (FontSize: 13, TextColor: #C7D7E5, Wrap: true);
          }
        }
      }

      #PatchnotesBox {
        LayoutMode: Left;
        Background: #0E141D;
        Padding: (Horizontal: 12, Vertical: 8);
        Anchor: (Height: 46, Bottom: 16);

        Label {
          Text: "Patchnotes v0.5.8: 100 Slots live • HyQuery Discovery aktiv • 100x100 RPG Bauwelt-Spawn • View-Radius optimiert (12).";
          Anchor: (Height: 30);
          Style: (FontSize: 12, TextColor: #94A3B8, Wrap: true, VerticalAlignment: Center);
        }
      }

      #ActionButtons {
        LayoutMode: Left;
        Anchor: (Height: 44);

        $C.@TextButton #StartGameButton {
          Text: "LOSLEGEN & SPIELEN";
          FlexWeight: 2;
          Anchor: (Right: 10, Height: 44);
        }

        $C.@SecondaryTextButton #OpenHandbookButton {
          Text: "HANDBUCH OEFFNEN";
          FlexWeight: 1;
          Anchor: (Right: 10, Height: 44);
        }

        $C.@SecondaryTextButton #WebsiteButton {
          Text: "WEBSITE & GITHUB";
          FlexWeight: 1;
          Anchor: (Height: 44);
        }
      }
    }
  }
}
